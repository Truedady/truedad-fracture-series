{
  "name": "truedad-fracture-experiment",
  "version": "1.0.0",
  "private": true,
  "description": "TrueDad «30 дней Fracture Case» — Remotion template, style «Монтаж без излишеств»",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "render": "remotion render src/index.ts --codec h264 --crf 16 --audio-bitrate 320k --pixel-format yuv420p --concurrency=3 --timeout=120000",
    "draft": "remotion render src/index.ts --codec h264 --crf 20 --audio-bitrate 320k --pixel-format yuv420p --concurrency=3 --timeout=120000"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
