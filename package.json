{
  "name": "truedad-fracture-series",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "npm run render:master && bash scripts/finalize.sh out/fracture-day01.mp4",
    "render:master": "remotion render src/index.ts FractureDay1 out/fracture-day01.mp4 --codec h264 --crf 17 --pixel-format yuv420p --audio-codec aac --audio-bitrate 256k",
    "render:draft": "remotion render src/index.ts FractureDay1 out/draft.mp4 --scale 0.5",
    "still": "remotion still src/index.ts FractureDay1 out/preview.png --frame 30",
    "typecheck": "tsc --noEmit -p .",
    "captions": "python3 scripts/build-captions.py captions/day01.asr-raw.json data/day01.captions.json",
    "sfx": "python3 scripts/generate-sfx.py 44.1"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
